  },
  title: { fontSize: "24px", fontWeight: 800, color: "#0f172a", margin: 0 },
  subtitle: { fontSize: "14px", color: "#64748b", marginTop: "4px" },
  warehouseSelectorGroup: {
    display: "flex",
